  "synthetic_wts": {
    "schema_version": 1.0,
    "module": "WTS",
    "purpose": "synthetic_test",
    "method_status": "synthetic_only",
    "seed": 314159.0,
    "run_id": "synthetic-wts",
    "output_dir": "test-output",
    "counts": "tests/synthetic/wts_counts.tsv",
    "metadata": "tests/synthetic/wts_metadata.tsv",
    "input_scale": "raw_integer_counts",
    "count_annotation_columns": [
      "transcript_id"
    ],
    "gene_id_policy": "preserve",
    "duplicate_gene_policy": "error",
    "fit_scope": "per_comparison",
    "comparisons": [
      {
        "id": "S1_S5_S9",
        "factor": "group",
        "numerator": "HPpos_Normal",
        "denominator": "HPneg_Normal",
        "design": "~ group",
        "model_kind": "independent",
        "repeated_patients": "error",
        "reference_levels": {
          "group": "HPneg_Normal"
        }
      },
      {
        "id": "S2_S6_S10",
        "factor": "group",
        "numerator": "HPpos_Tumor",
        "denominator": "HPpos_Normal",
        "design": "~ group",
        "model_kind": "independent",
        "repeated_patients": "error",
        "reference_levels": {
          "group": "HPpos_Normal"
        }
      },
      {
        "id": "S3_S7_S11",
        "factor": "group",
        "numerator": "HPpos_Tumor",
        "denominator": "HPneg_Tumor",
        "design": "~ group",
        "model_kind": "independent",
        "repeated_patients": "error",
        "reference_levels": {
          "group": "HPneg_Tumor"
        }
      },
      {
        "id": "S4_S8_S12",
        "factor": "group",
        "numerator": "HPneg_Tumor",
        "denominator": "HPneg_Normal",
        "design": "~ group",
        "model_kind": "independent",
        "repeated_patients": "error",
        "reference_levels": {
          "group": "HPneg_Normal"
        }
      }
    ],
    "prefilter": {
      "mode": "remove_all_zero"
    },
    "deseq": {
      "test": "Wald",
      "fitType": "parametric",
      "sfType": "ratio",
      "minReplicatesForReplace": {
        "__r_number__": "Inf"
      }
    },
    "results": {
      "alpha": 0.1,
      "pAdjustMethod": "BH",
      "independentFiltering": true,
      "cooksCutoff": true
    },
    "deg": {
      "padj_cutoff": 0.05,
      "abs_log2fc_cutoff": 1.0
    },
    "gene_mapping": "tests/synthetic/gene_mapping.tsv",
    "mapping_duplicate_policy": "error",
    "annotation_label": "Artificial mapping for tests only",
    "gsea": {
      "enabled": false
    }
  },
